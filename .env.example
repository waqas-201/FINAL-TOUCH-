# PostgreSQL connection string. Required by all catalogue, order, and admin routes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: defaults are supplied for local development only. Set these in Vercel.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-a-long-random-secret
